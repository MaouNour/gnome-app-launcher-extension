<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gnome-launcher" path="/org/gnome/shell/extensions/gnome-launcher/">

    <!-- General -->
    <!-- Mutter keeps one global list of keybinding names, so this key name must be unique. -->
    <key name="gnome-launcher-toggle" type="as"><default>["&lt;Control&gt;&lt;Alt&gt;space"]</default></key>
    <key name="use-super-key" type="b"><default>false</default></key>
    <!-- Applications in which every launcher shortcut is released (games, VMs...): window class,
         application id or desktop id, "*" and "?" wildcards allowed -->
    <key name="blocklist" type="as"><default>[]</default></key>
    <!-- Also release the shortcuts while the focused window is fullscreen -->
    <key name="block-fullscreen" type="b"><default>false</default></key>
    <key name="reset-query-on-open" type="b"><default>true</default></key>
    <key name="monitor" type="s"><default>'pointer'</default></key>
    <!-- What happens when the pointer interacts outside the window: click | hover | none -->
    <key name="outside-action" type="s"><default>'click'</default></key>
    <key name="placeholder" type="s"><default>'Search apps, commands and actions…'</default></key>
    <key name="show-descriptions" type="b"><default>true</default></key>
    <key name="show-tags" type="b"><default>true</default></key>

    <!-- Layout (logical pixels, multiplied by "scale") -->
    <key name="width" type="i"><default>640</default><range min="300" max="2400"/></key>
    <key name="window-height" type="i"><default>0</default><range min="0" max="2400"/></key>
    <key name="max-height" type="i"><default>480</default><range min="100" max="2400"/></key>
    <key name="search-height" type="i"><default>52</default><range min="24" max="200"/></key>
    <key name="search-position" type="s"><default>'top'</default></key>
    <key name="position" type="i"><default>18</default><range min="0" max="95"/></key>
    <key name="row-height" type="i"><default>48</default><range min="24" max="160"/></key>
    <key name="icon-size" type="i"><default>32</default><range min="12" max="128"/></key>
    <key name="font-size" type="d"><default>11</default><range min="6" max="40"/></key>
    <!-- Three font slots. Empty family / 0 weight = use the theme's; size 0 = automatic (relative to font-size).
         font-size above is the size of the main (results) font. -->
    <key name="font-search" type="s"><default>''</default></key>
    <key name="font-size-search" type="d"><default>0</default><range min="0" max="40"/></key>
    <key name="font-weight-search" type="i"><default>0</default><range min="0" max="900"/></key>
    <key name="font-main" type="s"><default>''</default></key>
    <key name="font-weight-main" type="i"><default>0</default><range min="0" max="900"/></key>
    <key name="font-secondary" type="s"><default>''</default></key>
    <key name="font-size-secondary" type="d"><default>0</default><range min="0" max="40"/></key>
    <key name="font-weight-secondary" type="i"><default>0</default><range min="0" max="900"/></key>
    <key name="scale" type="d"><default>1.0</default><range min="0.5" max="3.0"/></key>
    <key name="padding" type="i"><default>10</default><range min="0" max="60"/></key>
    <key name="result-spacing" type="i"><default>2</default><range min="0" max="40"/></key>
    <key name="search-padding" type="i"><default>14</default><range min="0" max="60"/></key>
    <key name="icon-spacing" type="i"><default>12</default><range min="0" max="60"/></key>
    <!-- Search field icon: an icon-theme name or an absolute path; empty hides it -->
    <key name="search-icon" type="s"><default>'edit-find-symbolic'</default></key>
    <key name="search-icon-size" type="i"><default>16</default><range min="8" max="64"/></key>
    <!-- The results list always scrolls; this only decides whether a scrollbar is drawn -->
    <key name="show-scrollbar" type="b"><default>false</default></key>

    <!-- Animation -->
    <!-- theme (follow the theme) | fade-scale | fade | slide | pop | drop | rise | none -->
    <key name="anim-style" type="s"><default>'theme'</default></key>
    <key name="anim-duration" type="i"><default>150</default><range min="0" max="1000"/></key>

    <!-- Themes -->
    <key name="theme-mode" type="s"><default>'auto'</default></key>
    <key name="theme-light" type="s"><default>'default-light'</default></key>
    <key name="theme-dark" type="s"><default>'default-dark'</default></key>
    <key name="custom-themes" type="s"><default>'[]'</default></key>
    <key name="theme-overrides" type="s"><default>'{}'</default></key>

    <!-- User data (JSON strings, validated on load) -->
    <key name="commands" type="s"><default>'[]'</default></key>
    <key name="actions" type="s"><default>'[]'</default></key>
    <key name="category-icons" type="s"><default>'{"Applications":"application-x-executable","Commands":"utilities-terminal","Actions":"system-run"}'</default></key>

    <!-- Built-in entries -->
    <key name="builtins" type="s"><default>'{}'</default></key>
    <key name="clipboard-enabled" type="b"><default>true</default></key>
    <key name="clipboard-max" type="i"><default>25</default><range min="5" max="200"/></key>
    <key name="calculator" type="b"><default>true</default></key>

    <!-- Images in clipboard history (memory only, never written to disk) -->
    <key name="clipboard-images" type="b"><default>true</default></key>
    <key name="clipboard-image-count" type="i"><default>8</default><range min="1" max="30"/></key>
    <key name="clipboard-image-mb" type="i"><default>4</default><range min="1" max="32"/></key>

    <!-- Accounts: only name/username/URL are stored here (JSON). Passwords live in the GNOME Keyring. -->
    <key name="accounts-enabled" type="b"><default>true</default></key>
    <key name="accounts" type="s"><default>'[]'</default></key>
    <!-- Seconds a copied password may stay on the clipboard (0 = never clear) -->
    <key name="account-clear-seconds" type="i"><default>20</default><range min="0" max="600"/></key>

    <!-- Emoji picker -->
    <key name="emoji-enabled" type="b"><default>true</default></key>
    <!-- Typing ":smile" in the main search shows emoji results inline -->
    <key name="emoji-inline" type="b"><default>true</default></key>
    <key name="emoji-inline-count" type="i"><default>8</default><range min="1" max="50"/></key>
    <!-- Where a chosen emoji is copied: clipboard | buffer | both | none -->
    <key name="emoji-store" type="s"><default>'clipboard'</default></key>
    <!-- Also type the emoji into the previously focused window and close the launcher -->
    <key name="emoji-paste" type="b"><default>false</default></key>
    <!-- Keys sent to paste: auto | ctrl-v | ctrl-shift-v | shift-insert -->
    <key name="emoji-paste-keys" type="s"><default>'auto'</default></key>
    <!-- Font used to draw emoji. Naming it explicitly means the shell does not have to search the system's
         font list (and every emoji-capable font on it) for each glyph. Empty = automatic. -->
    <key name="emoji-font" type="s"><default>'Noto Color Emoji'</default></key>
    <!-- How the emoji picker lists emoji: list | grid -->
    <key name="emoji-layout" type="s"><default>'list'</default></key>
    <!-- Size of one grid cell in pixels (before the overall scale) -->
    <key name="emoji-grid-size" type="i"><default>44</default><range min="28" max="96"/></key>
    <!-- Show recently/frequently used emoji first -->
    <key name="emoji-remember" type="b"><default>true</default></key>

    <!-- Search -->
    <!-- Word shared by all of the launcher's own entries (Emoji Picker, Clipboard History,
         power actions...). Typing exactly this word lists them all; empty disables it. -->
    <key name="own-keyword" type="s"><default>'app'</default></key>
    <!-- Regular expressions in the search box: off | prefix (text starting with "/") | always
         (any text containing regex characters that compiles and is safe) -->
    <key name="regex-mode" type="s"><default>'prefix'</default></key>
    <!-- Offer "search the web / ask an AI" entries: off | empty (when nothing was found) | always -->
    <key name="web-fallback" type="s"><default>'empty'</default></key>
    <!-- JSON list of {id, name, url (with {query}), icon, ai, enabled} -->
    <key name="web-providers" type="s"><default>'[{"id":"google","name":"Google","url":"https://www.google.com/search?q={query}","icon":"system-search-symbolic","ai":false,"enabled":true},{"id":"duckduckgo","name":"DuckDuckGo","url":"https://duckduckgo.com/?q={query}","icon":"system-search-symbolic","ai":false,"enabled":false},{"id":"claude","name":"Claude","url":"https://claude.ai/new?q={query}","icon":"dialog-question-symbolic","ai":true,"enabled":true},{"id":"chatgpt","name":"ChatGPT","url":"https://chatgpt.com/?q={query}","icon":"dialog-question-symbolic","ai":true,"enabled":true},{"id":"perplexity","name":"Perplexity","url":"https://www.perplexity.ai/search?q={query}","icon":"dialog-question-symbolic","ai":true,"enabled":false}]'</default></key>
    <!-- When true both result limits below are ignored and the list can be scrolled through
         every match (rows are created lazily while scrolling, so this stays cheap) -->
    <key name="unlimited-results" type="b"><default>false</default></key>
    <key name="max-results" type="i"><default>30</default><range min="5" max="200"/></key>
    <key name="initial-results" type="i"><default>8</default><range min="0" max="50"/></key>
    <key name="fuzzy" type="b"><default>true</default></key>
    <key name="search-descriptions" type="b"><default>true</default></key>
    <key name="frecency" type="b"><default>true</default></key>

    <!-- Performance -->
    <key name="prebuild-ui" type="b"><default>true</default></key>
    <key name="persist-cache" type="b"><default>true</default></key>
    <key name="cache-generation" type="i"><default>0</default></key>
    <key name="stats-generation" type="i"><default>0</default></key>

    <!-- Advanced -->
    <key name="debug" type="b"><default>false</default></key>
  </schema>
</schemalist>
